# Git ignore for Lammah monorepo

# Environment files
.env
.env.backup
.env.production

# IDE and OS
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Laravel Backend ignore
backend/vendor/
backend/node_modules/
backend/waha-server/node_modules/
backend/storage/app/waha_sessions/
backend/public/storage
backend/storage/*.key
backend/database/*.sqlite
backend/database/*.sqlite-journal

# Flutter Mobile ignore
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.pub-cache/
mobile/.pub/
mobile/*.png


# Python cache
__pycache__/
*.pyc

# Deployment scripts and server credentials
scripts/deploy_*.py
scripts/create_user.py
scripts/*.key
scripts/*.pem
