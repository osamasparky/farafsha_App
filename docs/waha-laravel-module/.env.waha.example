# Laravel application
WAHA_BASE_URL=http://waha:3000
WAHA_WEBHOOK_URL=http://app:8000/api/webhooks/waha
WAHA_API_KEY=replace-with-32-plus-random-bytes
WAHA_WEBHOOK_TOKEN=replace-with-a-different-32-plus-random-bytes
WAHA_DEFAULT_SESSION=default
WAHA_HTTP_TIMEOUT=20
WAHA_CONNECT_TIMEOUT=3
WAHA_QUEUE=whatsapp
WAHA_WEBHOOK_QUEUE=whatsapp-webhooks
WAHA_MAX_ATTEMPTS=3

# WAHA service environment (set in Compose environment)
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=False
WAHA_DASHBOARD_ENABLED=False
WHATSAPP_SWAGGER_ENABLED=False
WHATSAPP_DEFAULT_ENGINE=WEBJS
